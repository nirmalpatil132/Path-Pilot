datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     Session[]
  profile      StudentProfile?
  roadmaps     Roadmap[]
  projects     Project[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StudentProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  isOnboardingCompleted Boolean             @default(false)
  currentStep           Int                 @default(1)
  completedAt           DateTime?

  // Step 2: Education
  degree                String?
  branch                String?
  currentYear           String?
  university            String?
  college               String?
  cgpa                  Float?
  academicContext       String?

  // Step 5: Interests (stored as JSON array string)
  interests             String?

  // Step 6: Goals
  primaryGoal           String?
  secondaryGoals        String?             // JSON array string

  // Step 7: Constraints
  preferredLocation     String?
  workMode              String?
  weeklyHours           String?
  targetTimeline        String?
  financialContext      String?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  skills                ProfileSkill[]
  experiences           ProfileExperience[]
}

model ProfileSkill {
  id          String         @id @default(cuid())
  profileId   String
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  proficiency String         @default("Intermediate") // Beginner | Intermediate | Advanced
  createdAt   DateTime       @default(now())

  @@unique([profileId, name])
}

model ProfileExperience {
  id           String         @id @default(cuid())
  profileId    String
  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type         String         // internship | project | freelance | competition | certification | open_source | other
  title        String
  organization String?
  description  String?
  startDate    String?
  endDate      String?
  link         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Career {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  category           String        // Engineering | Data | Security | Infrastructure | Design
  summary            String
  description        String
  responsibilities   String        // JSON array of strings
  commonJobTitles    String        // JSON array of strings
  exampleProjects    String        // JSON array of { title: string, description: string, skills?: string[] }
  prerequisites      String?       // JSON array of strings
  relatedCareerSlugs String?       // JSON array of strings (e.g. ["full-stack-developer"])
  growthPaths        String?       // JSON array of strings
  interviewAreas     String?       // JSON array of strings
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  skills             CareerSkill[]
  roadmaps           Roadmap[]
  projects           Project[]
}

model CareerSkill {
  id          String   @id @default(cuid())
  careerId    String
  career      Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  name        String
  type        String   // "core" | "supporting"
  description String?
  createdAt   DateTime @default(now())

  @@unique([careerId, name])
}

model Roadmap {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId           String
  career             Career        @relation(fields: [careerId], references: [id], onDelete: Cascade)
  careerSlug         String
  careerTitle        String
  version            Int           @default(1)
  status             String        @default("ACTIVE") // ACTIVE | ARCHIVED
  weeklyHoursAssumed Int           @default(10)
  totalDays          Int           @default(30)
  totalTasks         Int           @default(0)
  completedTasks     Int           @default(0)
  inProgressTasks    Int           @default(0)
  blockedTasks       Int           @default(0)
  progressPercentage Float         @default(0.0)
  skillGapsAddressed String        // JSON array of strings
  assumptions        String?       // JSON array of strings
  deferredSkills     String?       // JSON array of strings
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tasks              RoadmapTask[]

  @@index([userId, status])
}

model RoadmapTask {
  id                 String    @id @default(cuid())
  roadmapId          String
  roadmap            Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  weekNumber         Int       // 1, 2, 3, 4
  dayNumber          Int       // 1 to 30
  dayRange           String    // e.g. "Days 1–3"
  orderIndex         Int
  title              String
  description        String
  estimatedMinutes   Int       // e.g. 120
  skillName          String
  skillCategory      String    // "CRITICAL_MISSING" | "RECOMMENDED_NEXT" | "OPTIONAL_ADVANTAGE" | "PROJECT"
  prerequisites      String?   // JSON array of strings
  completionCriteria String
  expectedOutput     String
  status             String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | BLOCKED
  notes              String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deliverables       ProjectDeliverable[]

  @@index([roadmapId, weekNumber])
}

model Project {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String
  source         String               @default("CUSTOM") // "TEMPLATE" | "CUSTOM"
  templateId     String?
  careerId       String?
  career         Career?              @relation(fields: [careerId], references: [id], onDelete: SetNull)
  careerSlug     String?
  careerTitle    String?
  skills         String               // JSON array of strings e.g. ["React", "TypeScript"]
  status         String               @default("PLANNED") // "PLANNED" | "IN_PROGRESS" | "COMPLETED" | "ARCHIVED"
  startDate      String?
  completionDate String?
  repositoryUrl  String?
  liveDemoUrl    String?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  deliverables   ProjectDeliverable[]

  @@index([userId])
  @@index([userId, status])
  @@index([careerId])
}

model ProjectDeliverable {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String
  type          String       @default("FEATURE_MODULE") // "FEATURE_MODULE" | "CODE_REPOSITORY" | "DEPLOYED_DEMO" | "TEST_SUITE" | "DESIGN_PROTOTYPE" | "TECHNICAL_DOCS" | "IMPLEMENTATION_NOTE"
  status        String       @default("SUBMITTED") // "PLANNED" | "SUBMITTED"
  url           String?
  roadmapTaskId String?
  roadmapTask   RoadmapTask? @relation(fields: [roadmapTaskId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId])
}
